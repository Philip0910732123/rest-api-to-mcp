{
  "openapi": "3.0.0",
  "info": {
    "title": "Pet Demo API",
    "version": "1.2.0",
    "description": "Minimal OpenAPI 3.0 spec used to smoke-test rest-api-to-mcp. Covers GET/POST/DELETE, path params, enum + integer query params, and a JSON request body."
  },
  "servers": [{ "url": "https://petstore3.swagger.io/api/v3" }],
  "paths": {
    "/pet/findByStatus": {
      "get": {
        "operationId": "findPetsByStatus",
        "summary": "按状态查宠物",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["available", "pending", "sold"] },
            "description": "宠物状态"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 },
            "description": "返回条数"
          }
        ]
      }
    },
    "/pet/{petId}": {
      "get": {
        "operationId": "getPetById",
        "summary": "按 ID 查宠物",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "宠物 ID"
          }
        ]
      },
      "delete": {
        "operationId": "deletePet",
        "summary": "删除宠物",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "宠物 ID"
          }
        ]
      }
    },
    "/pet": {
      "post": {
        "operationId": "addPet",
        "summary": "新增宠物",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}

#!/usr/bin/env python3
# Auto-generated by rest-api-to-mcp (--mode skill). Zero-dependency REST wrapper.
# Mirrors the ucsc-genome-api skill pattern but uses only the Python standard library
# (no `requests` install needed).
import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from urllib.parse import urljoin

SOURCE = "{{SOURCE}}"
DEFAULT_BASE_URL = "{{BASE_URL}}"
DEFAULT_METHOD = "GET"

# ---- Auth (seeded from OpenAPI securitySchemes or --auth) ----
API_KEY_ENV = "{{AUTH_ENV}}"                 # env var holding the secret (empty = no auth)
AUTH_HEADER_NAME = "{{AUTH_HEADER_NAME}}"    # header that carries the secret
AUTH_HEADER_PREFIX = "{{AUTH_HEADER_PREFIX}}"  # text prepended to the secret (e.g. "Bearer ")
AUTH_QUERY_PARAM = "{{AUTH_QUERY_PARAM}}"    # query param name for the secret (empty = none)

# ---- Endpoint catalogue (seeded from OpenAPI paths / manual list) ----
ENDPOINTS = {{ENDPOINTS}}


def parse_json_dict(raw, arg_name):
    if not raw:
        return {}
    try:
        obj = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ValueError(f"Invalid JSON for {arg_name}: {exc}") from exc
    if not isinstance(obj, dict):
        raise ValueError(f"{arg_name} must be a JSON object")
    return obj


def parse_headers(items):
    headers = {}
    for item in items:
        if ":" not in item:
            raise ValueError(f"Invalid header format: {item} (expected Key:Value)")
        key, value = item.split(":", 1)
        headers[key.strip()] = value.strip()
    return headers


# Git Bash / MSYS rewrites a leading-slash argument: "/pet/1" arrives here as
# "C:/Program Files/Git/pet/1". Recover the endpoint the caller meant.
GIT_ROOT_SEGMENTS = ("PortableGit", "Git Bash", "Git", "mingw64")


def demangle_windows_path(endpoint):
    """Return the POSIX-style endpoint hidden in a Windows path, else None."""
    p = endpoint.replace("\\", "/")
    if not (len(p) > 2 and p[1] == ":" and p[0].isalpha()):
        return None
    for seg in GIT_ROOT_SEGMENTS:
        marker = "/" + seg + "/"
        idx = p.find(marker)
        if idx != -1:
            rest = p[idx + len(marker) - 1:]
            return rest if rest.startswith("/") else "/" + rest
    tail = p[2:]
    return tail if tail.startswith("/") else "/" + tail


def normalize_endpoint(endpoint):
    endpoint = endpoint.strip()
    if endpoint.startswith("http://") or endpoint.startswith("https://"):
        return endpoint
    demangled = demangle_windows_path(endpoint)
    if demangled is not None:
        endpoint = demangled
    if not endpoint.startswith("/"):
        endpoint = "/" + endpoint
    return endpoint


def pick_endpoint_from_prompt(prompt):
    p = prompt.lower()
    scored = []
    for ep in ENDPOINTS:
        score = sum(1 for kw in ep.get("keywords", []) if kw.lower() in p)
        if score > 0:
            scored.append((score, ep))
    if not scored:
        return None
    scored.sort(key=lambda x: x[0], reverse=True)
    best_score = scored[0][0]
    ties = [ep for s, ep in scored if s == best_score]
    # 唯一胜出才采用；平局或无命中都视为不明确，交给 --endpoint
    return ties[0] if len(ties) == 1 else None


def estimate_count(data):
    if isinstance(data, list):
        return len(data)
    if isinstance(data, dict):
        for key in ("results", "items", "data", "hits", "rows", "entries"):
            value = data.get(key)
            if isinstance(value, list):
                return len(value)
        return 1 if data else 0
    return 1 if data else 0


def detect_next_page(data, headers):
    if isinstance(data, dict):
        for key in ("next", "next_page", "nextPage", "cursor", "offset"):
            if key in data and data[key]:
                return data[key]
    link = headers.get("Link") or headers.get("link")
    if link:
        return link
    return None


def build_url(base_url, endpoint, params=None):
    endpoint = normalize_endpoint(endpoint)
    if endpoint.startswith("http://") or endpoint.startswith("https://"):
        base = endpoint
    else:
        base = urljoin(base_url.rstrip("/") + "/", endpoint.lstrip("/"))
    if params:
        q = urllib.parse.urlencode(params)
        base = base + ("&" if "?" in base else "?") + q
    return base


def run_request(args):
    endpoint = ""
    method = args.method
    if args.endpoint:
        endpoint = args.endpoint
    elif args.prompt:
        ep = pick_endpoint_from_prompt(args.prompt)
        if ep:
            endpoint = ep["path"]
            if args.method == DEFAULT_METHOD and ep.get("method"):
                method = ep["method"]
        else:
            listing = ", ".join(f'{e["method"]} {e["path"]}' for e in ENDPOINTS) or "(none)"
            raise ValueError(
                "Could not infer endpoint from prompt. Available endpoints:\n  " + listing
                + "\nPass --endpoint explicitly (see references/api_quickref.md)."
            )
    else:
        raise ValueError("One of --endpoint or --prompt is required")

    params = parse_json_dict(args.params, "--params")
    body = parse_json_dict(args.body, "--body")
    headers = {"Accept": "application/json"}
    headers.update(parse_headers(args.header))

    api_key = os.getenv(API_KEY_ENV, "") if API_KEY_ENV else ""
    if api_key:
        if AUTH_HEADER_NAME:
            headers[AUTH_HEADER_NAME] = f"{AUTH_HEADER_PREFIX}{api_key}" if AUTH_HEADER_PREFIX else api_key
        if AUTH_QUERY_PARAM:
            params.setdefault(AUTH_QUERY_PARAM, api_key)

    url = build_url(args.base_url, endpoint, params)
    method = method.upper()
    data_body = None
    if method in {"POST", "PUT", "PATCH"} and body:
        data_body = json.dumps(body).encode("utf-8")

    req = urllib.request.Request(url, data=data_body, method=method)
    for k, v in headers.items():
        req.add_header(k, v)
    if data_body is not None:
        req.add_header("Content-Type", "application/json")

    try:
        resp = urllib.request.urlopen(req, timeout=args.timeout)
        raw = resp.read().decode("utf-8", "replace")
        status = resp.status
        resp_headers = dict(resp.getheaders())
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        status = e.code
        resp_headers = dict(e.headers.items())
    except urllib.error.URLError as e:
        # 网络层错误：直接返回带真实 URL 的错误信封，避免外层兜底地址失真
        return {
            "status": "error",
            "source": SOURCE,
            "request": {"method": method, "url": url, "params": params, "timeout": args.timeout},
            "count": 0,
            "data": None,
            "errors": [f"Network error: {e.reason}"],
            "next_page": None,
        }

    try:
        payload = json.loads(raw)
    except ValueError:
        payload = raw

    errors = []
    if status >= 400:
        errors.append(
            f"HTTP {status} from {url}: "
            + (payload[:500] if isinstance(payload, str) else str(payload)[:500])
        )

    return {
        "status": "ok" if not errors else "error",
        "source": SOURCE,
        "request": {"method": method, "url": url, "params": params, "timeout": args.timeout},
        "count": estimate_count(payload),
        "data": payload,
        "errors": errors,
        "next_page": detect_next_page(payload, resp_headers),
    }


def main():
    parser = argparse.ArgumentParser(description=f"Query {SOURCE} via official API endpoint")
    parser.add_argument("--prompt", default="", help="Natural-language prompt for endpoint selection (best-effort)")
    parser.add_argument("--endpoint", default="", help="Direct endpoint path or full URL")
    parser.add_argument("--base-url", default=DEFAULT_BASE_URL, help="API base URL")
    parser.add_argument("--method", default=DEFAULT_METHOD, help="HTTP method")
    parser.add_argument("--params", default="{}", help="JSON object for query parameters")
    parser.add_argument("--body", default="{}", help="JSON object for request body")
    parser.add_argument("--header", action="append", default=[], help="Extra header in Key:Value format")
    parser.add_argument("--timeout", type=int, default=60, help="Request timeout seconds")
    parser.add_argument("--out", default="", help="Optional output JSON path")
    args = parser.parse_args()

    try:
        result = run_request(args)
    except Exception as exc:
        result = {
            "status": "error",
            "source": SOURCE,
            "request": {
                "method": args.method.upper(),
                "url": build_url(args.base_url, args.endpoint or "", {}),
                "params": {},
                "timeout": args.timeout,
            },
            "count": 0,
            "data": None,
            "errors": [str(exc)],
            "next_page": None,
        }

    text = json.dumps(result, ensure_ascii=False, indent=2)
    if args.out:
        with open(args.out, "w", encoding="utf-8") as f:
            f.write(text + "\n")
    print(text)
    return 0 if result.get("status") == "ok" else 1


if __name__ == "__main__":
    sys.exit(main())
